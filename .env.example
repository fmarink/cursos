# Base de datos
DATABASE_URL="postgresql://usuario:clave@localhost:5432/uppercap?schema=public"

# Secreto de sesión — mínimo 32 caracteres, distinto por ambiente
SESSION_SECRET="genere-uno-largo-y-aleatorio-por-ejemplo-con-openssl-rand-base64-32"

# URL pública: se incrusta en los códigos QR y la usa el generador de PDF
APP_URL="http://localhost:3000"

# Ruta a Chromium si no está en las ubicaciones habituales
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

# Correo transaccional: "consola" (simulado) o "resend"
CORREO_PROVEEDOR="consola"
# RESEND_API_KEY=""
# CORREO_REMITENTE="Uppercap <no-reply@uppercap.cl>"
